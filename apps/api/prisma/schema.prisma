generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COUNTRY_MANAGER
  AGENCY_MANAGER
}

enum MonitoringType {
  KILOMETERS
  HOURS
}

enum DocumentType {
  DRIVING_LICENSE
  MEDICAL_CERTIFICATE
}

enum VehicleDocumentType {
  ITP
  RCA
  REGISTRATION
  INSURANCE
  OTHER
}

enum NotificationType {
  ITP_EXPIRING
  RCA_EXPIRING
  REVISION_DUE
  DRIVER_LICENSE_EXPIRING
  DRIVER_MEDICAL_EXPIRING
}

// ─── Utilizatori si Autentificare ────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          Role
  agency        Agency?        @relation(fields: [agencyId], references: [id])
  agencyId      String?
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Agentii ─────────────────────────────────────────────────────

model Agency {
  id        String    @id @default(uuid())
  name      String
  address   String?
  city      String?
  users         User[]
  vehicles      Vehicle[]
  drivers       Driver[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("agencies")
}

// ─── Categorii Vehicule (Globale) ────────────────────────────────

model VehicleCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("vehicle_categories")
}

// ─── Vehicule ────────────────────────────────────────────────────

model Vehicle {
  id                String            @id @default(uuid())
  name              String
  plateNumber       String            @unique
  category          VehicleCategory   @relation(fields: [categoryId], references: [id])
  categoryId        String
  agency            Agency            @relation(fields: [agencyId], references: [id])
  agencyId          String
  monitoringType    MonitoringType
  currentKm         Float?            @default(0)
  currentHours      Float?            @default(0)
  revisionThreshold Float?
  itpExpiryDate     DateTime?
  rcaExpiryDate     DateTime?
  drivers           DriverVehicle[]
  documents         VehicleDocument[]
  notifications     Notification[]
  telemetryLive     TelemetryLive?
  telemetryHistory  TelemetryHistory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("vehicles")
}

// ─── Soferi ──────────────────────────────────────────────────────

model Driver {
  id        String           @id @default(uuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  agency    Agency           @relation(fields: [agencyId], references: [id])
  agencyId  String
  vehicles      DriverVehicle[]
  documents     DriverDocument[]
  notifications Notification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("drivers")
}

model DriverDocument {
  id         String       @id @default(uuid())
  driver     Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId   String
  type       DocumentType
  expiryDate DateTime?
  filePath   String?
  fileName   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("driver_documents")
}

model VehicleDocument {
  id         String              @id @default(uuid())
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String
  type       VehicleDocumentType
  expiryDate DateTime?
  filePath   String?
  fileName   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("vehicle_documents")
}

// ─── Legatura Sofer-Vehicul (Many-to-Many) ───────────────────────

model DriverVehicle {
  id        String   @id @default(uuid())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId  String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  createdAt DateTime @default(now())

  @@unique([driverId, vehicleId])
  @@map("driver_vehicles")
}

// ─── Notificari / Alerte ─────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String?
  driver    Driver?          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId  String?
  agency    Agency           @relation(fields: [agencyId], references: [id])
  agencyId  String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([agencyId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Telemetrie / GPS ────────────────────────────────────────────

model TelemetryLive {
  id         String   @id @default(uuid())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String   @unique
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  updatedAt  DateTime @updatedAt

  @@map("telemetry_live")
}

model TelemetryHistory {
  id         String   @id @default(uuid())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  createdAt  DateTime @default(now())

  @@index([vehicleId, createdAt])
  @@map("telemetry_history")
}
