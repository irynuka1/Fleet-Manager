# Copy to apps/api/.env
# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnikinetix?schema=public"

# JWT — REQUIRED outside development. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Allowed browser origin outside development
CORS_ORIGIN="http://localhost:5173"
# Set to true behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false

# SMTP (alert emails; skipped when SMTP_HOST is empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Daily alert job timezone
CRON_TIMEZONE="Europe/Bucharest"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Secure flag of the refresh cookie (defaults to true outside development)
# COOKIE_SECURE=true
